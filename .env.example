# Generic OpenAI-compatible model config.
# For DeepSeek, BASE_URL should be https://api.deepseek.com
API_KEY=your_api_key
MODEL_ID=deepseek-v4-flash
BASE_URL=https://api.deepseek.com

# Optional. If omitted, the agent infers DeepSeek when BASE_URL contains deepseek.
# AGENT_PROVIDER=deepseek

# Robot gateway. Simulated mode is the default.
# ROBOT_RUNTIME_ADAPTER=simulated
# ROBOT_MODE=http
# ROBOT_BASE_URL=http://127.0.0.1:9000
# ROBOT_ALLOW_MOTION=1
# ROBOT_GATEWAY_WATCHDOG_S=15
# ROBOT_SIM_TIME_SCALE=1

# Symbolic remote-service whitelist. The model never receives or supplies URLs.
# REMOTE_SERVICES={"demo":"http://127.0.0.1:9020","perception":"http://127.0.0.1:9030"}
